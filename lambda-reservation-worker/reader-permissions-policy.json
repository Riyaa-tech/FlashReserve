{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReservationAndInventoryItemsOnly",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:ap-south-1:<AWS_ACCOUNT_ID>:table/FlashReserveReservations",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "RESERVATION#*",
            "EVENT#*"
          ]
        }
      }
    },
    {
      "Sid": "CreateOwnLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:ap-south-1:<AWS_ACCOUNT_ID>:log-group:/aws/lambda/flashreserve-reservation-reader"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:<AWS_ACCOUNT_ID>:log-group:/aws/lambda/flashreserve-reservation-reader:*"
    }
  ]
}
